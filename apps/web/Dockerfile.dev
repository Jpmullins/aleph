FROM node:22-alpine

WORKDIR /app/apps/web

COPY apps/web/package.json ./package.json

# Standalone npm install: avoids pnpm 10's build-script gating (CopilotKit
# pulls @scarf/scarf whose postinstall pnpm refuses to run), and keeps the
# web app out of the root pnpm workspace. Vite lands in ./node_modules.
RUN npm install

COPY apps/web ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
