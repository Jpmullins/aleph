FROM node:22-alpine

WORKDIR /app/apps/web

RUN corepack enable

COPY apps/web/package.json ./package.json

# Standalone install (ignore root pnpm-workspace.yaml so the web app
# doesn't drag tests/playwright into its closure and so Vite is
# installed into ./node_modules where `pnpm dev` can find it).
RUN pnpm install --no-frozen-lockfile --ignore-workspace

COPY apps/web ./

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
