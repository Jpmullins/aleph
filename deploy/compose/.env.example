# Aleph local stack — copy to .env and fill in secrets.
# .env is gitignored; never commit it.

# Project
ALEPH_ENV=local
ALEPH_DEFAULT_MODEL_PROFILE=aleph-dev

# Auth mode.
#   local — default for local dev. Bypasses OIDC; API JIT-provisions
#           a single `dev@aleph.local` principal. No IdP service runs.
#   oidc  — production. Fill in ALEPH_AUTH_ISSUER / ALEPH_AUTH_AUDIENCE /
#           ALEPH_AUTH_JWKS_URL (Cognito, Auth0, Authentik, Keycloak,
#           ALB OIDC — anything that exposes a JWKS endpoint).
ALEPH_AUTH_MODE=local
VITE_AUTH_MODE=local
ALEPH_AUTH_ISSUER=
ALEPH_AUTH_AUDIENCE=aleph
ALEPH_AUTH_JWKS_URL=
ALEPH_AUTH_CLIENT_ID=aleph-web

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aleph
POSTGRES_USER=aleph
POSTGRES_PASSWORD=changeme-local
DATABASE_URL=postgresql+asyncpg://aleph:changeme-local@postgres:5432/aleph

# Asset storage — fs (default) stores bytes under data/assets (bind-mounted
# into aleph-api + aleph-workers); everything reaches the browser through the
# authenticated streaming route.
ALEPH_ASSET_BACKEND=fs

# --- Opt-in s3 asset backend (docker compose --profile s3 up -d) ---
# Uncomment ALL of the below and set ALEPH_ASSET_BACKEND=s3. MINIO_ROOT_*
# configure the MinIO container itself; the ALEPH_S3_* keys point Aleph at it
# (or at any external S3-compatible endpoint, in which case skip the profile).
#MINIO_ROOT_USER=aleph
#MINIO_ROOT_PASSWORD=changeme-local
#ALEPH_S3_ENDPOINT=http://minio:9000
#ALEPH_S3_ACCESS_KEY=aleph
#ALEPH_S3_SECRET_KEY=changeme-local
#ALEPH_S3_BUCKET=aleph-local

# Redis
REDIS_URL=redis://redis:6379/0

# Langfuse — generate strong random values:
#   openssl rand -hex 32   # for each of the *_SECRET / SALT / ENCRYPTION_KEY
# LANGFUSE_AUTH = base64(LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY) — used
# by the OTel collector's Basic auth to ingest traces. Compute via:
#   echo -n "$LANGFUSE_PUBLIC_KEY:$LANGFUSE_SECRET_KEY" | base64 -w0
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-with-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-bytes-required-here-yes
LANGFUSE_PUBLIC_KEY=pk-lf-aleph-local-replace
LANGFUSE_SECRET_KEY=sk-lf-aleph-local-replace
LANGFUSE_AUTH=replace-with-base64-of-public-colon-secret
# Langfuse v3 infra (ClickHouse OLAP store + its own Redis queue + its own
# blob store). v3 ingests OTEL natively; the collector forwards spans here.
CLICKHOUSE_PASSWORD=replace-with-openssl-rand-hex-16
LANGFUSE_REDIS_AUTH=replace-with-openssl-rand-hex-16
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-openssl-rand-hex-16

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# LiteLLM Gateway — the only LLM transport for api / workers.
LITELLM_BASE_URL=https://gateway.insights.arlis.umd.edu
INSIGHTS_LITELLM_API_KEY=

# Scholar (WP-2). ALEPH_SCHOLAR_MAILTO is the polite-pool contact sent to
# Crossref/OpenAlex on every request; ALEPH_CONSENSUS_MONTHLY_SEARCH_CAP
# meters Consensus searches per project per month (Pro plan allows 250 —
# keep the cap under it). The Consensus OAuth credential itself lives in the
# DB (scripts/connect-consensus.py), never in env.
#ALEPH_SCHOLAR_MAILTO=dev@aleph.local
#ALEPH_CONSENSUS_MONTHLY_SEARCH_CAP=200

# Connector dev-default keys (per-project credentials override these in Inc 3+)
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ARTIFICIALANALYSIS_API_KEY=
OPENAI_API_KEY=
LENS_API_KEY=

# Internal API base URL. Workers re-enter aleph-api over HTTP for all state
# mutations (architecture rule #3) using this base; on the compose network it
# resolves to the api service by name.
ALEPH_API_INTERNAL_URL=http://aleph-api:8000

# Agent-token signing secret (HS256), used aleph-api ↔ workers.
# Generate via: openssl rand -hex 32
ALEPH_AGENT_TOKEN_SECRET=replace-with-openssl-rand-hex-32
