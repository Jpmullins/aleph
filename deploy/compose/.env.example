# Aleph local stack — copy to .env and fill in secrets.
# .env is gitignored; never commit it.

# Project
ALEPH_ENV=local
ALEPH_DEFAULT_MODEL_PROFILE=aleph-dev

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aleph
POSTGRES_USER=aleph
POSTGRES_PASSWORD=changeme-local
DATABASE_URL=postgresql+asyncpg://aleph:changeme-local@postgres:5432/aleph

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=aleph
MINIO_ROOT_PASSWORD=changeme-local
ALEPH_S3_BUCKET=aleph-local

# Redis
REDIS_URL=redis://redis:6379/0

# Langfuse — generate strong random values for SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-with-openssl-rand-hex-32
# 64-hex-char encryption key (32 bytes). Generate via:
#   openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-bytes-required-here-yes
LANGFUSE_PUBLIC_KEY=pk-lf-aleph-local-replace
LANGFUSE_SECRET_KEY=sk-lf-aleph-local-replace

# OTEL
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# LiteLLM Gateway — the only LLM transport. Required.
LITELLM_BASE_URL=https://gateway.insights.arlis.umd.edu
INSIGHTS_LITELLM_API_KEY=

# Connector dev-default keys (per-project credentials override these in Inc 3+)
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ARTIFICIALANALYSIS_API_KEY=
OPENAI_API_KEY=
LENS_API_KEY=

# Auth (OIDC). For local dev, run a Keycloak realm at localhost:8080.
ALEPH_AUTH_ISSUER=http://localhost:8080/realms/aleph
ALEPH_AUTH_AUDIENCE=aleph
ALEPH_AUTH_JWKS_URL=http://localhost:8080/realms/aleph/protocol/openid-connect/certs
ALEPH_AUTH_CLIENT_ID=aleph-web

# Agent-token signing secret (HS256). 32+ bytes random.
# Generate via: openssl rand -hex 32
ALEPH_AGENT_TOKEN_SECRET=replace-with-openssl-rand-hex-32
