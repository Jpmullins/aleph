# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/
.venv/
venv/
.python-version
build/
dist/

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
.vite/
dist/
.next/

# Env + secrets — never commit
.env
.env.local
.env.*.local
deploy/compose/.env
*.env.local
API_keys.txt
secrets/

# Local data dirs (fs asset store lives under /data/assets). The tracked
# .gitkeep guarantees data/assets exists user-owned on a fresh clone — if the
# Docker daemon creates the bind-mount source instead, it's root-owned and the
# uid-mapped api/workers containers can't write assets.
/data/*
!/data/assets
/data/assets/*
!/data/assets/.gitkeep
deploy/compose/data/
**/.minio.sys/

# Editor + OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Coverage + reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.eval-reports/

# Playwright artifacts (dev iteration + CI test outputs)
.playwright-mcp/
tests/playwright/test-results/
tests/playwright/playwright-report/

# uv lockfile is committed; per-app caches are not
.uv/

# Session screenshots (driver/verification output) — never commit
/*.png
/*.jpeg
/*.jpg

# graphify code-graph artifacts (generated, local)
.graphify/
